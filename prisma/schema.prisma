generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String             @id @default(cuid())
  name            String
  normalizedName  String             @unique
  logo            String?
  website         String?
  createdAt       DateTime           @default(now())
  levels          Level[]
  submissions     SalarySubmission[]

  @@index([name])
  @@map("companies")
}

model Role {
  id          String             @id @default(cuid())
  name        String             @unique
  submissions SalarySubmission[]

  @@map("roles")
}

model Level {
  id          String             @id @default(cuid())
  companyId   String
  levelCode   String
  levelName   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions SalarySubmission[]

  @@unique([companyId, levelCode])
  @@index([companyId])
  @@map("levels")
}

model Location {
  id          String             @id @default(cuid())
  city        String
  state       String?
  country     String
  submissions SalarySubmission[]

  @@unique([city, state, country])
  @@index([country])
  @@index([city])
  @@map("locations")
}

model User {
  id          String             @id @default(cuid())
  email       String?            @unique
  createdAt   DateTime           @default(now())
  submissions SalarySubmission[]

  @@map("users")
}

model SalarySubmission {
  id                 String   @id @default(cuid())
  companyId          String
  roleId             String
  levelId            String
  locationId         String
  userId             String?
  baseSalary         Int
  bonus              Int      @default(0)
  stock              Int      @default(0)
  totalCompensation  Int
  yearsExperience    Int
  fingerprint        String   @unique
  submittedAt        DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id])
  level    Level    @relation(fields: [levelId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([companyId, levelId])
  @@index([roleId, locationId])
  @@index([totalCompensation])
  @@index([submittedAt])
  @@index([yearsExperience])
  @@index([companyId, roleId, locationId])
  @@map("salary_submissions")
}
